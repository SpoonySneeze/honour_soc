Magic 271485
Revision Verdi_U-2023.03-SP1

; ============================================================
; Peripheral Subsystem Top Testbench – Verdi Waveform RC
; Target: tb/tb_soc_top.v (FSDB: tb_soc_top.fsdb)
; ============================================================

viewPort 0 0 1600 900 250 100
signalSpacing 5

zoom 0.000000 10000000.000000
cursor 0.000000
marker 0.000000

top 0
markerPos 0

COMPLEX_EVENT_BEGIN
COMPLEX_EVENT_END

curSTATUS ByChange

; ============================================================
; Group 1: Clock & Master Reset
; ============================================================
addGroup "1. Clock & Reset"
addSignal -h 15 /tb_soc_top/clk
addSignal -h 15 -holdScope rst_n

; ============================================================
; Group 2: Host AXI Master (64-bit LSU Interface)
; ============================================================
addGroup "2. Host AXI Master (S01)"
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/axi_awaddr[31:0]
addSignal -h 15 -holdScope axi_awvalid
addSignal -h 15 -holdScope axi_awready
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_wdata[63:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_wstrb[7:0]
addSignal -h 15 -holdScope axi_wvalid
addSignal -h 15 -holdScope axi_wready
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_bresp[1:0]
addSignal -h 15 -holdScope axi_bvalid
addSignal -h 15 -holdScope axi_bready
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_araddr[31:0]
addSignal -h 15 -holdScope axi_arvalid
addSignal -h 15 -holdScope axi_arready
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_rdata[63:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope axi_rresp[1:0]
addSignal -h 15 -holdScope axi_rvalid
addSignal -h 15 -holdScope axi_rready

; ============================================================
; Group 3: External Pins & Monitored Signals
; ============================================================
addGroup "3. External Pins"
addSignal -h 15 /tb_soc_top/heartbeat_in
addSignal -h 15 -holdScope reset_out
addSignal -h 15 -holdScope uart_tx
addSignal -h 15 -holdScope uart_rx
addSignal -h 15 -holdScope vga_hsync
addSignal -h 15 -holdScope vga_vsync
addSignal -h 15 -UNSIGNED -HEX -holdScope vga_rgb[11:0]

; ============================================================
; Group 4: Heartbeat Monitor (Slave 3: 0x0002_0300)
; ============================================================
addGroup "4. Heartbeat Monitor (M03)"
addSignal -h 15 /tb_soc_top/m03_axi_awvalid
addSignal -h 15 -holdScope m03_axi_awready
addSignal -h 15 -UNSIGNED -HEX -holdScope m03_axi_wdata[63:0]
addSignal -h 15 /tb_soc_top/m03_axi_arvalid
addSignal -h 15 -holdScope m03_axi_arready
addSignal -h 15 -UNSIGNED -HEX -holdScope m03_axi_rdata[63:0]
addSignal -h 15 /tb_soc_top/u_hbm/u_hbm/hb_active
addSignal -h 15 -UNSIGNED -UDEC -holdScope hb_counter[31:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope hb_threshold_reg[31:0]
addSignal -h 15 -holdScope unresponsive
addSignal -h 15 -holdScope sticky_unresponsive
addSignal -h 15 /tb_soc_top/hb_irq

; ============================================================
; Group 5: Power/Reset Sequencer (Slave 4: 0x0002_0400)
; ============================================================
addGroup "5. Reset Sequencer (M04)"
addSignal -h 15 /tb_soc_top/m04_axi_awvalid
addSignal -h 15 -holdScope m04_axi_awready
addSignal -h 15 -UNSIGNED -HEX -holdScope m04_axi_wdata[63:0]
addSignal -h 15 /tb_soc_top/m04_axi_arvalid
addSignal -h 15 -holdScope m04_axi_arready
addSignal -h 15 -UNSIGNED -HEX -holdScope m04_axi_rdata[63:0]
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_rst_seq/u_seq/current_state[2:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope timer_count[31:0]
addSignal -h 15 -holdScope in_progress
addSignal -h 15 -holdScope trigger_cold
addSignal -h 15 -holdScope trigger_warm

; ============================================================
; Group 6: Recovery Policy & Circular Log (Slave 5: 0x0002_0500)
; ============================================================
addGroup "6. Recovery Policy (M05)"
addSignal -h 15 /tb_soc_top/m05_axi_awvalid
addSignal -h 15 -holdScope m05_axi_awready
addSignal -h 15 -UNSIGNED -HEX -holdScope m05_axi_wdata[63:0]
addSignal -h 15 /tb_soc_top/m05_axi_arvalid
addSignal -h 15 -holdScope m05_axi_arready
addSignal -h 15 -UNSIGNED -HEX -holdScope m05_axi_rdata[63:0]
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_rec_pol/u_pol/escalation_state[2:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope window_recovery_count[3:0]
addSignal -h 15 -holdScope lockout_flag
addSignal -h 15 /tb_soc_top/lockout_irq
addSignal -h 15 -UNSIGNED -UDEC /tb_soc_top/u_rec_pol/u_pol/log_wr_ptr[3:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope log_count[7:0]

; ============================================================
; Group 7: Timer & GPIO (Slaves 1 & 2)
; ============================================================
addGroup "7. Timer & GPIO"
