addSignal -h 15 /tb_soc_top/vblank_irq
addSignal -h 15 /tb_soc_top/vga_hsync
addSignal -h 15 -holdScope vga_vsync
addSignal -h 15 -UNSIGNED -HEX -holdScope vga_rgb[11:0]
