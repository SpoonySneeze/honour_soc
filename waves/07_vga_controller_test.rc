Magic 271485
Revision Verdi_U-2023.03-SP1

; VGA Display Controller Timing & Video Signals
; Target: soc_top_uvm_tb/tb_top.sv (FSDB: soc_uvm.fsdb)

viewPort 0 0 1600 900 320 65
signalSpacing 5

zoom 0.000000 200000000.000000
cursor 100000.000000
marker 0.000000

top 0
markerPos 0

COMPLEX_EVENT_BEGIN
COMPLEX_EVENT_END

curSTATUS ByChange

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_top/clk
addSignal -h 15 /tb_top/rst_n

addGroup "2. VGA Boundary Pins & VIP"
addSignal -h 15 /tb_top/u_dut/vga_hsync
addSignal -h 15 /tb_top/u_dut/vga_vsync
addSignal -h 15 -UNSIGNED -HEX /tb_top/u_dut/vga_rgb[11:0]
addSignal -h 15 /tb_top/vga_vif/vga_hsync
addSignal -h 15 /tb_top/vga_vif/vga_vsync
addSignal -h 15 -UNSIGNED -HEX /tb_top/vga_vif/vga_rgb[11:0]

addGroup "3. Raster Timing Counters & Sync"
addSignal -h 15 -UNSIGNED -UDEC /tb_top/u_dut/u_vga/u_core/h_count[9:0]
addSignal -h 15 -UNSIGNED -UDEC /tb_top/u_dut/u_vga/u_core/v_count[9:0]
addSignal -h 15 /tb_top/u_dut/u_vga/u_core/active_video
addSignal -h 15 /tb_top/u_dut/u_vga/u_core/vblank_irq

